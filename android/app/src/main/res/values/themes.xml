<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FFF4F6FA</color>
    <color name="icon_bg">#FF2F6FDE</color>

    <!-- Светлая тема системы. WebView получает prefers-color-scheme по isLightTheme темы. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- до Android 8.1 значки панели навигации всегда белые — оставляем её тёмной -->
        <item name="android:navigationBarColor">#FF14171D</item>
    </style>
</resources>
